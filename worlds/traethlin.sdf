<?xml version="1.0" encoding='ASCII'?>
<sdf version='1.7'>
  <world name='traethlin_world'>
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='libignition-gazebo-physics-system.so'/>
    <plugin name="ignition::gazebo::systems::Sensors" filename="libignition-gazebo-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <plugin name="ignition::gazebo::systems::Imu" filename="libignition-gazebo-imu-system.so"/>
    <plugin name="ignition::gazebo::systems::NavSat" filename="libignition-gazebo-navsat-system.so"/>

    <gui fullscreen="0">
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>



    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>52.41516780808094</latitude_deg>
      <longitude_deg>-4.065390697470451</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="traethlin_landscape">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://materials/textures/heightmap.png</uri>
            <size>100 100 10</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <texture>
              <diffuse>file://materials/textures/dirt_diffusespecular.png</diffuse>
              <normal>file://materials/textures/flat_normal.png</normal>
              <size>5</size>
            </texture>
            <texture>
              <diffuse>file://materials/textures/grass_diffusespecular.png</diffuse>
              <normal>file://materials/textures/flat_normal.png</normal>
              <size>5</size>
            </texture>
            <texture>
              <diffuse>file://materials/textures/fungus_diffusespecular.png</diffuse>
              <normal>file://materials/textures/flat_normal.png</normal>
              <size>20</size>
            </texture>
            <blend>
              <min_height>1</min_height>
              <fade_dist>2</fade_dist>
            </blend>
            <blend>
              <min_height>5</min_height>
              <fade_dist>2</fade_dist>
            </blend>
            <uri>model://materials/textures/heightmap.png</uri>
            <size>100 100 10</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
        <plugin
          filename="ignition-gazebo-thermal-system"
          name="gz::sim::systems::Thermal">
          <temperature>293.15</temperature>
        </plugin>
      </visual>
    </link>
    <link name="water">
      <visual name="water_visual">
        <pose>0 0 0.2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.0 0.0 0.5 1</ambient>
          <diffuse>0.0 0.0 0.5 1</diffuse>
          <specular>0.3 0.3 0.3 0</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <plugin
          filename="ignition-gazebo-thermal-system"
          name="gz::sim::systems::Thermal">
          <temperature>288.15</temperature>
        </plugin>
      </visual>
    </link>
  </model>


  </world>
</sdf>
